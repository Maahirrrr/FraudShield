# FraudShield Cloud Infrastructure (OpenTofu / Terraform compatible)
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "aws_region" {
  type    = string
  default = "ap-south-1" # Mumbai region for low Indian latency
}

provider "aws" {
  region = var.aws_region
}

resource "aws_security_group" "fraudshield_sg" {
  name        = "fraudshield-traffic"
  description = "Allow HTTP and internal scoring ports"

  ingress {
    description = "Dashboard Web Console"
    from_port   = 5000
    to_port     = 5000
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "Java Core REST API"
    from_port   = 8085
    to_port     = 8085
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "FastAPI Microservice (Private/Internal)"
    from_port   = 8000
    to_port     = 8000
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
